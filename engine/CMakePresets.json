{
    "version": 3,
    "cmakeMinimumRequired": {
        "major": 3,
        "minor": 22,
        "patch": 1
    },
    "configurePresets": [
        {
            "name": "base-wsl",
            "hidden": true,
            "generator": "Ninja",
            "environment": {
                "VCPKG_MAX_CONCURRENCY": "4",
                "VCPKG_DOWNLOADS": "$env{HOME}/.cache/vcpkg-downloads",
                "VCPKG_BINARY_SOURCES": "clear;files,$env{HOME}/.cache/vcpkg-archives,readwrite"
            },
            "cacheVariables": {
                "CMAKE_C_COMPILER": "/usr/bin/clang-18",
                "CMAKE_CXX_COMPILER": "/usr/bin/clang++-18",
                "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
                "CMAKE_TOOLCHAIN_FILE": "${sourceDir}/vendor/vcpkg/scripts/buildsystems/vcpkg.cmake",
                "CMAKE_EXE_LINKER_FLAGS": "-fuse-ld=lld-18",
                "CMAKE_SHARED_LINKER_FLAGS": "-fuse-ld=lld-18",
                "CMAKE_MODULE_LINKER_FLAGS": "-fuse-ld=lld-18",
                "VCPKG_INSTALLED_DIR": "${sourceDir}/out/vcpkg_installed",
                "VCPKG_TARGET_TRIPLET": "x64-linux",
                "VCPKG_OVERLAY_TRIPLETS": "${sourceDir}/cmake/vcpkg-triplets",
                "VCPKG_INSTALL_OPTIONS": "--clean-after-build"
            }
        },
        {
            "name": "debug",
            "inherits": "base-wsl",
            "displayName": "Debug (Clang-18)",
            "binaryDir": "${sourceDir}/out/debug",
            "cacheVariables": { "CMAKE_BUILD_TYPE": "Debug" }
        },
        {
            "name": "release",
            "inherits": "base-wsl",
            "displayName": "Release (Clang-18)",
            "binaryDir": "${sourceDir}/out/release",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release",
                "VCPKG_TARGET_TRIPLET": "x64-linux-release"
            }
        },
        {
            "name": "release-lto",
            "inherits": "release",
            "displayName": "Release LTO (Clang-18)",
            "binaryDir": "${sourceDir}/out/release-lto",
            "cacheVariables": {
                "CMAKE_C_FLAGS": "-flto=thin",
                "CMAKE_CXX_FLAGS": "-flto=thin",
                "CMAKE_EXE_LINKER_FLAGS": "-fuse-ld=lld-18 -flto=thin",
                "CMAKE_SHARED_LINKER_FLAGS": "-fuse-ld=lld-18 -flto=thin",
                "CMAKE_MODULE_LINKER_FLAGS": "-fuse-ld=lld-18 -flto=thin"
            }
        },
        {
            "name": "asan",
            "inherits": "base-wsl",
            "displayName": "Address Sanitizer (Clang-18)",
            "binaryDir": "${sourceDir}/out/asan",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug",
                "CMAKE_CXX_FLAGS": "-fsanitize=address,undefined -g -gsplit-dwarf -O1 -fno-omit-frame-pointer",
                "CMAKE_EXE_LINKER_FLAGS": "-fsanitize=address,undefined"
            }
        },
        {
            "name": "tsan",
            "inherits": "base-wsl",
            "displayName": "Thread Sanitizer (Clang-18)",
            "binaryDir": "${sourceDir}/out/tsan",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug",
                "CMAKE_CXX_FLAGS": "-fsanitize=thread -g -gsplit-dwarf -O1",
                "CMAKE_EXE_LINKER_FLAGS": "-fsanitize=thread"
            }
        }
    ],
    "buildPresets": [
        { "name": "debug", "configurePreset": "debug", "jobs": 4 },
        { "name": "release", "configurePreset": "release", "jobs": 4 },
        { "name": "release-lto", "configurePreset": "release-lto", "jobs": 4},
        { "name": "asan", "configurePreset": "asan", "jobs": 4 },
        { "name": "tsan", "configurePreset": "tsan", "jobs": 4 }
    ],
    "testPresets": [
        { "name": "debug", "configurePreset": "debug", "output": { "outputOnFailure": true } },
        { "name": "release", "configurePreset": "release", "output": { "outputOnFailure": true } },
        { "name": "release-lto", "configurePreset": "release-lto", "output": { "outputOnFailure": true } },
        { "name": "asan", "configurePreset": "asan", "output": { "outputOnFailure": true } },
        { "name": "tsan", "configurePreset": "tsan", "output": { "outputOnFailure": true } }
    ]
}
