# ==============================================================================
# strix/engine/Justfile
# Can be used only after executing 'bash bootstrap.sh'.
#
# Requires: just (https://github.com/casey/just)
# Help:     just --list
# ==============================================================================

# Automatically load .env, failed if not present.
set dotenv-required := true
set shell := ["bash", "-euo", "pipefail", "-c"]

cmake_bin := if path_exists("vendor/cmake/bin/cmake") == "true" {
    "vendor/cmake/bin/cmake"      
} else { "cmake" }

# List all available recipes
default:
    @just --list

# ------------------------------------------------------------------------------
# Registry
# Add new Benchmark suite names here only; all *-all targets pick them up 
# automatically. Test suites are automatically discovered by CTest.
# ------------------------------------------------------------------------------
bench_names := "avx2_kernel inference custom_ops free_list level0_ring vector_search"
test_names := "avx2_kernel inference control_block free_list level0_ring"

# ==============================================================================
# General
# ==============================================================================

# Create secret file .env
init-env:
    @bash init_env.sh

# Configure specified preset
config preset="debug":
    @{{cmake_bin}} --preset {{preset}}

# Build specified preset
build preset="debug" target="strix_engine":
    @{{cmake_bin}} --build --preset {{preset}} --target {{target}}

# Configure & build under Release
release: (config "release") (build "release")

# Configure & build under Debug
debug: (config) (build)

# ==============================================================================
# Benchmark
# ==============================================================================

# Benchmark one suite
bench name: (config "release") (build "release" name + "_bench")
    @./out/release/{{name}}_bench

# Benchmark all suites
bench-all: (config "release")
    #!/usr/bin/env bash
    for name in {{bench_names}}; do
        {{cmake_bin}} --build --preset release --target ${name}_bench 2>&1 | grep -v '^$'
    done
    for name in {{bench_names}}; do
        ./out/release/${name}_bench
    done

# ==============================================================================
# Test
# ==============================================================================

# Test single suite against one preset
test name preset="debug": (config preset) (build preset name + "_test")
    @./out/{{preset}}/{{name}}_test

# Tess all suites against one preset
test-preset preset="debug": (config preset)
    #!/usr/bin/env bash
    for name in {{test_names}}; do
        {{cmake_bin}} --build --preset {{preset}} --target ${name}_test
    done
    for name in {{test_names}}; do
        ./out/{{preset}}/${name}_test
    done

# Test all suites against all presets
test-all: (test-preset "debug") (test-preset "release")

# ==============================================================================
# Sanitizers
# ==============================================================================

# Test single suite under Address Sanitizer
asan name: (config "asan") (build "asan" name + "_test")
    @./out/asan/{{name}}_test

# Test all suites under Address Sanitizer
asan-all: (config "asan")
    #!/usr/bin/env bash
    for name in {{test_names}}; do
        {{cmake_bin}} --build --preset asan --target ${name}_test
    done
    for name in {{test_names}}; do
        ./out/asan/${name}_test
    done

# Test single suite under Thread Sanitizer
tsan name: (config "tsan") (build "tsan" name + "_test")
    @./out/tsan/{{name}}_test

# Test all suites under Thread Sanitizer
tsan-all: (config "tsan")
    #!/usr/bin/env bash
    for name in {{test_names}}; do
        {{cmake_bin}} --build --preset tsan --target ${name}_test
    done
    for name in {{test_names}}; do
        ./out/tsan/${name}_test
    done

# Sanitize Address & Thread
sanitize: asan-all tsan-all

# ==============================================================================
# Cleanup
# ==============================================================================

# Remove artifacts of specified preset
clear preset="debug":
    @{{cmake_bin}} --build --preset {{preset}} --target clean

# Remove artifacts across all presets
clear-all:
    #!/usr/bin/env bash
    for preset in debug release asan tsan; do
        if [ -d "out/$preset/" ]; then
            {{cmake_bin}} --build --preset "$preset" --target clean
        fi
    done

# Wipe out everything including CMake cache
nuke:
    @rm -rf out/
    @echo "Nuked artifact directory"
    @mkdir -p out/
